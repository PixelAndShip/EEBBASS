{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++-20 ALL files (Raylib)",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-std=c++20",
                "-I${workspaceFolder}",
                "-I${workspaceFolder}/src",
                "-I${workspaceFolder}/src/units",
                "-I${workspaceFolder}/src/units/brain_nodes",
                "-I${workspaceFolder}/src/data_management",
                "-I${workspaceFolder}/src/core",
                "-I${workspaceFolder}/src/ui",
                "-I${workspaceFolder}/dbgtools",
                "main.cpp",
                "src/data_management/sim_manager.cpp",
                "src/core/environment.cpp",
                "src/core/spider.cpp",
                "src/ui/interface.cpp",
                "src/units/agent.cpp",
                "src/units/brain.cpp",
                "src/units/plant.cpp",
                "src/units/brain_nodes/input_node.cpp",
                "src/units/brain_nodes/node_functions.cpp",
                "dbgtools/debug.cpp",
                "-L/usr/local/lib",
                "-lraylib",
                "-lGL",
                "-lm",
                "-lpthread",
                "-ldl",
                "-lrt",
                "-lX11",
                "-o",
                "${workspaceFolder}/main_linux"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "shell",
            "label": "Build with AddressSanitizer",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-std=c++20",
                "-I${workspaceFolder}",
                "-I${workspaceFolder}/src",
                "-I${workspaceFolder}/src/units",
                "-I${workspaceFolder}/src/units/brain_nodes",
                "-I${workspaceFolder}/src/data_management",
                "-I${workspaceFolder}/src/core",
                "-I${workspaceFolder}/src/ui",
                "-I${workspaceFolder}/dbgtools",
                "main.cpp",
                "src/data_management/sim_manager.cpp",
                "src/core/environment.cpp",
                "src/core/spider.cpp",
                "src/ui/interface.cpp",
                "src/units/agent.cpp",
                "src/units/brain.cpp",
                "src/units/plant.cpp",
                "src/units/brain_nodes/input_node.cpp",
                "src/units/brain_nodes/node_functions.cpp",
                "dbgtools/debug.cpp",
                "-L/usr/local/lib",
                "-lraylib",
                "-lGL",
                "-lm",
                "-lpthread",
                "-ldl",
                "-lrt",
                "-lX11",
                "-o",
                "${workspaceFolder}/main_AS"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Run AddressSanitizer",
            "type": "shell",
            "command": "${workspaceFolder}/main_asan",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Build with AddressSanitizer",
            "problemMatcher": []
        },
        {
            "label": "Valgrind Memcheck",
            "type": "shell",
            "command": "valgrind",
            "args": [
                "--leak-check=full",
                "--show-leak-kinds=all",
                "${workspaceFolder}/main_linux"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Build Raylib",
            "problemMatcher": []
        }
    ]
}