{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++ build ALL files (subdirs)",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "main.cpp",
                "Units/BrainNodes/*.cpp",
                "Units/*.cpp",
                "Environment/*.cpp",
                "DataTypes/datatypes.h",
                "-I.",
                "-IUnits",
                "-IUnits/BrainNodes",
                "-o",
                "${fileDirname}/main",
                "-lraylib",
                "-lGL",
                "-lm",
                "-lpthread",
                "-ldl",
                "-lrt",
                "-lX11"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}