{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++-20 ALL files (Raylib)",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-std=c++20",
                "-I${workspaceFolder}",
                "-I${workspaceFolder}/src",
                "-I${workspaceFolder}/src/backend/units",
                "-I${workspaceFolder}/src/backend/units/brain_nodes",
                "-I${workspaceFolder}/src/backend/data_management",
                "-I${workspaceFolder}/src/backend/core",
                "-I${workspaceFolder}/src/frontend",
                "-I${workspaceFolder}/dbgtools",
                "main.cpp",
                "src/backend/data_management/sim_manager.cpp",
                "src/backend/core/environment.cpp",
                "src/backend/core/spider.cpp",
                "src/backend/units/agent.cpp",
                "src/backend/units/brain.cpp",
                "src/backend/units/plant.cpp",
                "src/backend/units/brain_nodes/input_node.cpp",
                "src/backend/units/brain_nodes/node_functions.cpp",
                "src/frontend/components/environment_window.cpp",
                "src/frontend/components/input_form.cpp",
                "src/frontend/components/side_panel.cpp",
                "src/frontend/components/ui.cpp",
                "src/frontend/screens/screen_current.cpp",
                "src/frontend/screens/screens.cpp",
                "src/frontend/screens/screens_basic.cpp",
                "src/frontend/screens/screens_forms.cpp",
                "src/frontend/services/file_service.cpp",
                "src/frontend/services/interface.cpp",
                "src/frontend/services/simulation_controller.cpp",
                "dbgtools/debug.cpp",
                "-L/usr/local/lib",
                "-lraylib",
                "-lGL",
                "-lm",
                "-lpthread",
                "-ldl",
                "-lrt",
                "-lX11",
                "-o",
                "${workspaceFolder}/EEBBASS_linux"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "shell",
            "label": "Build with AddressSanitizer",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-std=c++20",
                "-fsanitize=address",
                "-fno-omit-frame-pointer",
                "-I${workspaceFolder}",
                "-I${workspaceFolder}/src",
                "-I${workspaceFolder}/src/backend/units",
                "-I${workspaceFolder}/src/backend/units/brain_nodes",
                "-I${workspaceFolder}/src/backend/data_management",
                "-I${workspaceFolder}/src/backend/core",
                "-I${workspaceFolder}/src/frontend",
                "-I${workspaceFolder}/dbgtools",
                "main.cpp",
                "src/backend/data_management/sim_manager.cpp",
                "src/backend/core/environment.cpp",
                "src/backend/core/spider.cpp",
                "src/backend/units/agent.cpp",
                "src/backend/units/brain.cpp",
                "src/backend/units/plant.cpp",
                "src/backend/units/brain_nodes/input_node.cpp",
                "src/backend/units/brain_nodes/node_functions.cpp",
                "src/frontend/components/environment_window.cpp",
                "src/frontend/components/input_form.cpp",
                "src/frontend/components/side_panel.cpp",
                "src/frontend/components/ui.cpp",
                "src/frontend/screens/screen_current.cpp",
                "src/frontend/screens/screens.cpp",
                "src/frontend/screens/screens_basic.cpp",
                "src/frontend/screens/screens_forms.cpp",
                "src/frontend/services/file_service.cpp",
                "src/frontend/services/interface.cpp",
                "src/frontend/services/simulation_controller.cpp",
                "dbgtools/debug.cpp",
                "-L/usr/local/lib",
                "-lraylib",
                "-lGL",
                "-lm",
                "-lpthread",
                "-ldl",
                "-lrt",
                "-lX11",
                "-o",
                "${workspaceFolder}/EEBBASS_AS"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Run AddressSanitizer",
            "type": "shell",
            "command": "${workspaceFolder}/EEBBASS_AS",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Build with AddressSanitizer",
            "problemMatcher": []
        },
        {
            "label": "Valgrind Memcheck",
            "type": "shell",
            "command": "valgrind",
            "args": [
                "--leak-check=full",
                "--show-leak-kinds=all",
                "${workspaceFolder}/EEBBASS_linux"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Build Raylib",
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "C++: Build Windows (Raylib) - Standalone",
            "command": "/usr/bin/x86_64-w64-mingw32-g++",
            "args": [
                "-std=c++20",
                "-O2",
                "-static-libgcc",
                "-static-libstdc++",
                "-s",
                "-I.",
                "-Isrc",
                "-Isrc/backend/units",
                "-Isrc/backend/units/brain_nodes",
                "-Isrc/backend/data_management",
                "-Isrc/backend/core",
                "-Isrc/frontend",
                "-Iexternal/raylib-6.0_win64_mingw-w64/include",
                "main.cpp",
                "src/backend/data_management/sim_manager.cpp",
                "src/backend/core/environment.cpp",
                "src/backend/core/spider.cpp",
                "src/backend/units/agent.cpp",
                "src/backend/units/brain.cpp",
                "src/backend/units/plant.cpp",
                "src/backend/units/brain_nodes/input_node.cpp",
                "src/backend/units/brain_nodes/node_functions.cpp",
                "src/frontend/components/environment_window.cpp",
                "src/frontend/components/input_form.cpp",
                "src/frontend/components/side_panel.cpp",
                "src/frontend/components/ui.cpp",
                "src/frontend/screens/screen_current.cpp",
                "src/frontend/screens/screens.cpp",
                "src/frontend/screens/screens_basic.cpp",
                "src/frontend/screens/screens_forms.cpp",
                "src/frontend/services/file_service.cpp",
                "src/frontend/services/interface.cpp",
                "src/frontend/services/simulation_controller.cpp",
                "-Lexternal/raylib-6.0_win64_mingw-w64/lib",
                "-lraylib",
                "-lopengl32",
                "-lgdi32",
                "-lwinmm",
                "-Wl,--defsym,stat64i32=_stat64",
                "-o",
                "${workspaceFolder}/EEBBASS_windows.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Build standalone Windows EEBASS executable using static Raylib"
        }
    ]
}
